font-family = "Source Code Pro"
font-size = 12
font-feature = -calt, -liga, -dlig

background = 000000
foreground = c3c3c3

cursor-style = block
cursor-style-blink = false

window-theme = dark

shell-integration-features = no-cursor

auto-update = check

window-step-resize = true

window-inherit-working-directory = false
